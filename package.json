{
  "name": "verifactu-js",
  "version": "0.0.0",
  "private": true,
  "description": "Toolkit TypeScript para VeriFactu (AEAT): huella, XML, QR y cliente SOAP.",
  "license": "MIT",
  "homepage": "https://github.com/verifactu-js/verifactu-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifactu-js/verifactu-js.git"
  },
  "bugs": {
    "url": "https://github.com/verifactu-js/verifactu-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:readmes": "node scripts/check-readmes.mjs",
    "check:manifest": "node scripts/reference-manifest.mjs --check",
    "check:invisibles": "node scripts/check-invisibles.mjs",
    "manifest": "node scripts/reference-manifest.mjs",
    "check:codigos": "node scripts/generar-codigos-aeat.mjs --check",
    "codigos": "node scripts/generar-codigos-aeat.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "node scripts/install-hooks.mjs",
    "probe:qr": "node scripts/probe-qr-encoding.mjs",
    "check:workspace": "node scripts/check-workspace-deps.mjs",
    "check:changelog": "node scripts/changelog.mjs --check",
    "check:publishable": "node scripts/check-first-publish.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "qrcode": "^1.5.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "xmllint-wasm": "^5.3.0"
  }
}
