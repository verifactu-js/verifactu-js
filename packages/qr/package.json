{
  "name": "@verifactu-js/qr",
  "version": "0.1.0",
  "description": "URL de cotejo y especificación del código QR tributario VERI*FACTU (AEAT). Cero dependencias. / Cotejo URL and tax QR specification for Spanish VERI*FACTU invoices.",
  "keywords": [
    "verifactu",
    "aeat",
    "qr",
    "cotejo",
    "factura",
    "spain"
  ],
  "license": "MIT",
  "homepage": "https://github.com/OWNER/verifactu-js/tree/main/packages/qr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/verifactu-js.git",
    "directory": "packages/qr"
  },
  "bugs": {
    "url": "https://github.com/OWNER/verifactu-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/emit-cts-types.mjs dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
