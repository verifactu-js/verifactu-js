{
  "name": "@verifactu-js/validation",
  "version": "0.1.1",
  "description": "Validaciones de negocio de la AEAT para registros VERI*FACTU, cada regla con su cita y la versión del documento. / AEAT business validations for Spanish VERI*FACTU billing records, each rule cited to its source document and version.",
  "keywords": [
    "verifactu",
    "veri-factu",
    "aeat",
    "facturacion",
    "factura",
    "sif",
    "validacion",
    "validation",
    "spain",
    "invoicing",
    "tax"
  ],
  "license": "MIT",
  "author": "Ridel Saavedra Flores <cosmoframeworks@gmail.com>",
  "homepage": "https://github.com/verifactu-js/verifactu-js/tree/main/packages/validation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifactu-js/verifactu-js.git",
    "directory": "packages/validation"
  },
  "bugs": {
    "url": "https://github.com/verifactu-js/verifactu-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verifactu-js/core": "^0.2.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/emit-cts-types.mjs dist",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
