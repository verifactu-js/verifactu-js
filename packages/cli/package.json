{
  "name": "@verifactu-js/cli",
  "version": "0.1.0",
  "description": "CLI para VERI*FACTU: comprueba el entorno antes de facturar y verifica cadenas de huellas ya emitidas. / CLI for Spanish VERI*FACTU: check the environment before invoicing, and verify already-issued hash chains.",
  "keywords": [
    "verifactu",
    "veri-factu",
    "aeat",
    "cli",
    "facturacion",
    "huella",
    "spain",
    "invoicing",
    "tax"
  ],
  "license": "MIT",
  "author": "Ridel Saavedra Flores <cosmoframeworks@gmail.com>",
  "homepage": "https://github.com/verifactu-js/verifactu-js/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifactu-js/verifactu-js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/verifactu-js/verifactu-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "verifactu-js": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verifactu-js/client": "^0.1.0",
    "@verifactu-js/core": "^0.2.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/emit-cts-types.mjs dist",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  }
}
