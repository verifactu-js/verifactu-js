{
  "name": "@verifactu-js/xml",
  "version": "0.1.0",
  "description": "Serialización al esquema oficial VERI*FACTU (AEAT), envoltorio SOAP y lectura de la respuesta. Sin dependencias de terceros. / Official VERI*FACTU schema serialisation, SOAP envelope and response parsing. No third-party dependencies.",
  "keywords": [
    "verifactu",
    "aeat",
    "xml",
    "xsd",
    "soap",
    "factura",
    "spain"
  ],
  "license": "MIT",
  "author": "Ridel Saavedra Flores <cosmoframeworks@gmail.com>",
  "homepage": "https://github.com/verifactu-js/verifactu-js/tree/main/packages/xml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifactu-js/verifactu-js.git",
    "directory": "packages/xml"
  },
  "bugs": {
    "url": "https://github.com/verifactu-js/verifactu-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verifactu-js/core": "^0.2.0",
    "@verifactu-js/validation": "^0.1.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/emit-cts-types.mjs dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
