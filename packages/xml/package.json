{
  "name": "@verifactu-js/xml",
  "version": "0.1.0",
  "private": true,
  "description": "Serialización al esquema oficial VERI*FACTU (AEAT) y envoltorio SOAP. Cero dependencias. / Official VERI*FACTU schema serialisation and SOAP envelope.",
  "keywords": [
    "verifactu",
    "aeat",
    "xml",
    "xsd",
    "soap",
    "factura",
    "spain"
  ],
  "license": "MIT",
  "homepage": "https://github.com/verifactu-js/verifactu-js/tree/main/packages/xml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verifactu-js/verifactu-js.git",
    "directory": "packages/xml"
  },
  "bugs": {
    "url": "https://github.com/verifactu-js/verifactu-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@verifactu-js/core": "workspace:^"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/emit-cts-types.mjs dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
