#!/bin/sh
#
# Secret scan before every commit.
#
# The repository will hold AEAT test certificates in CI secrets and, sooner or later, someone
# will drop a .p12 into the working tree. A leaked qualified certificate is not a bug you can
# patch: it has to be revoked. So this hook blocks rather than warns.
#
# Requires gitleaks: https://github.com/gitleaks/gitleaks
#   winget install gitleaks   |   brew install gitleaks   |   scoop install gitleaks

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'

  [pre-commit] gitleaks no está instalado y este repositorio lo exige.

  Instálalo:
    macOS         brew install gitleaks
    Windows       winget install gitleaks   (o: scoop install gitleaks)
    Linux         https://github.com/gitleaks/gitleaks/releases

  Si necesitas saltártelo puntualmente y sabes lo que haces:
    git commit --no-verify

EOF
  exit 1
fi

echo "[pre-commit] gitleaks: escaneando cambios en stage..."
# `git --staged` es la forma actual. `protect` sigue funcionando como alias obsoleto en 8.30,
# pero ya no aparece en la ayuda y acabará desapareciendo.
gitleaks git --staged --redact --verbose --no-banner --config .gitleaks.toml
echo "[pre-commit] gitleaks: sin hallazgos."
